# See supabase.md for Supabase credentials
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY
# Server-only, untuk webhook & pembuatan profil (JANGAN di-expose ke client):
# - SUPABASE_SERVICE_ROLE_KEY

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Configuration (Minimax - Anthropic-compatible)
AI_PROVIDER=anthropic
AI_MODEL_NAME=MiniMax-M2.7
ANTHROPIC_API_KEY=your_minimax_api_key
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# Payment Gateway (Xendit)
XENDIT_SECRET_KEY=your_xendit_secret_key
# Callback Verification Token dari dashboard Xendit (Settings > Webhooks).
# Webhook /api/webhook/payment menolak request tanpa token yang cocok.
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token

# Pasal.id API (Database Hukum Indonesia)
# Daftar token di https://pasal.id/api
PASAL_API_TOKEN=your_pasal_api_token

# Alternative AI Providers (uncomment to use)
# OpenAI:
# AI_PROVIDER=openai
# AI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=your_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi/Moonshot:
# AI_PROVIDER=openai
# AI_MODEL_NAME=moonshot-v1-128k
# OPENAI_API_KEY=your_key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
